# Reference only. Do not copy this file to .env on the production server.
# Export these values from the shell, CI/CD secret store, Docker secrets, or
# your orchestrator environment before running the production compose stack.

export PUBLIC_DOMAIN=your-domain.example
export DJANGO_SECRET_KEY=change_this_to_a_long_random_secret
export POSTGRES_PASSWORD=change_this_database_password

# Optional overrides. The production compose file derives these automatically
# from PUBLIC_DOMAIN and POSTGRES_PASSWORD for the normal Docker deployment.
export POSTGRES_DB=marketplace
export POSTGRES_USER=postgres
export DATABASE_URL=postgres://postgres:change_this_database_password@postgres:5432/marketplace
export REDIS_URL=redis://redis:6379/0
export CELERY_BROKER_URL=redis://redis:6379/0
export CELERY_RESULT_BACKEND=redis://redis:6379/0
export ALLOWED_HOSTS=your-domain.example,www.your-domain.example
export CORS_ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example
export CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
export VITE_API_URL=https://your-domain.example/api
export VITE_WS_URL=wss://your-domain.example/ws/notifications/
export PAYMENT_PROVIDER_KEYS=replace_with_real_provider_keys
