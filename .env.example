# Reference only. The app does not require copying this file to .env.
# For local Docker, docker-compose.yml and docker-compose.override.yml already
# provide these defaults. Export only the values you want to override.

export DATABASE_URL=postgres://postgres:postgres@postgres:5432/marketplace
export REDIS_URL=redis://redis:6379/0
export CELERY_BROKER_URL=redis://redis:6379/0
export CELERY_RESULT_BACKEND=redis://redis:6379/0
export DJANGO_SECRET_KEY=replace_this_with_a_secure_key
export DJANGO_DEBUG=1
export ALLOWED_HOSTS='*'
export CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
export CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
export VITE_API_URL=http://localhost:8007/api
export VITE_WS_URL=ws://localhost:8007/ws/notifications/
export PAYMENT_PROVIDER_KEYS=placeholder
